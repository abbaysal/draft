# ---- Database (Neon / Supabase / any managed Postgres) -------------------------
# Pooled connection for serverless functions (Neon: the "-pooler" host; Supabase: port 6543 + ?pgbouncer=true)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"
# Direct (non-pooled) connection used only for migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# ---- Access control -------------------------------------------------------------
# Strongly recommended for any public deployment: protects pages and all writes.
APP_PASSWORD=""
# ≥ 16 random characters; signs the session cookie (e.g. `openssl rand -hex 32`)
AUTH_SECRET=""
# Only if you deliberately want an unprotected writable deployment (not recommended)
ALLOW_ANONYMOUS_WRITES="false"

# ---- AI copilot (optional — the app works without it) ----------------------------
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
ANTHROPIC_EFFORT="low"

# ---- Scheduled refresh (Vercel Cron) ----------------------------------------------
# Vercel sends `Authorization: Bearer $CRON_SECRET` to /api/cron/refresh
CRON_SECRET=""
# Optional authorised data feeds you have the right to use (CSV / RSS)
PROJECTIONS_CSV_URL=""
AUTO_ACTIVATE_PROJECTIONS="false"
ADP_CSV_URL=""
SCHEDULE_CSV_URL=""
NEWS_FEED_URLS=""

# ---- Build -----------------------------------------------------------------------
# Set to true to skip the idempotent seed during `vercel-build`
SKIP_SEED="false"
